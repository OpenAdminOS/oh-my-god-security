{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "execution-contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roles": {
      "type": "object",
      "properties": {
        "host": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "model",
            "location"
          ]
        },
        "hunter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "model",
            "location"
          ]
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "model",
            "location"
          ]
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "model",
            "location"
          ]
        },
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "model",
            "location"
          ]
        }
      },
      "required": [
        "hunter",
        "verifier",
        "evaluator"
      ],
      "additionalProperties": false
    },
    "verification": {
      "enum": [
        "source_only",
        "sandbox_tests"
      ]
    },
    "retention": {
      "enum": [
        "reports_only",
        "evidence"
      ]
    },
    "pilot_call_limit": {
      "type": "integer",
      "minimum": 3,
      "maximum": 12
    },
    "accepted_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "source_ref",
    "scope",
    "exclusions",
    "roles",
    "verification",
    "retention",
    "pilot_call_limit",
    "accepted_by"
  ]
}
