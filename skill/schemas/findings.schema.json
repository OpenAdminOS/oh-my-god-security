{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMGS findings",
  "type": "object",
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fingerprint",
          "title",
          "verdict",
          "proof_tier",
          "attack_class",
          "entry_point",
          "sink",
          "boundary",
          "location",
          "hunted_by",
          "verified_by",
          "verification"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^omgs-[0-9a-f]{16}$"
          },
          "title": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "confirmed",
              "needs_validation",
              "rejected"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational"
            ]
          },
          "proof_tier": {
            "enum": [
              "traced",
              "test_proven",
              "sandbox_exploited"
            ]
          },
          "attack_class": {
            "type": "string",
            "description": "Must be registered in intent/classes.json (deprecated aliases retain existing fingerprints); unknown names are rejected with the valid entries.",
            "enum": ["artifact_poisoning", "client_only_auth", "command_injection", "credential_handling", "deletion_path_safety", "deserialization", "dom_injection", "download_and_execute", "download_integrity", "export_integrity", "export_scope", "fail_closed_semantics", "feed_to_policy_write", "generated_script_injection", "identity_binding", "idor_tenant_isolation", "import_parsing", "input_validation", "installer_signer_trust_bypass", "installer_version_downgrade", "integration_url", "ipc_authorization", "missing_authz", "output_encoding", "path_traversal", "privileged_local_ops", "search_control", "secret_disclosure", "sensor_hit", "shell_injection", "ssrf", "tenant_isolation", "unbounded_import_recursion", "webhook_replay", "webhook_signature", "client_only_authorization", "idor", "missing_authorization", "webhook_verification"]
          },
          "entry_point": {
            "type": "string"
          },
          "sink": {
            "type": "string"
          },
          "boundary": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "locations": {
            "type": "array",
            "description": "Further locations of the same root cause, so one copied defect stays one record.",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "evidence": {
            "type": "string"
          },
          "fix_brief": {
            "type": "string"
          },
          "intent_question": {
            "type": "string"
          },
          "intent_id": {
            "type": "string",
            "description": "Intent library question this record asks (omgs intent list)."
          },
          "family": {
            "type": "string"
          },
          "prerequisites": {
            "type": "string"
          },
          "hunted_by": {
            "type": "string",
            "minLength": 1,
            "description": "Hunter whose candidate produced this record."
          },
          "verified_by": {
            "type": "string",
            "minLength": 1,
            "description": "Independent verifier who decided this record. Must differ from hunted_by."
          },
          "candidates": {
            "type": "array",
            "uniqueItems": true,
            "description": "Fingerprints of further candidates merged into this record; its own fingerprint is implicit.",
            "items": {
              "type": "string",
              "pattern": "^omgs-[0-9a-f]{16}$"
            }
          },
          "proof_ref": {
            "type": "string",
            "pattern": "^proofs/[1-9][0-9]*\\.json$",
            "description": "The proof record omgs prove wrote beside this findings file. Required when proof_tier is test_proven or sandbox_exploited."
          },
          "trace": {
            "type": "array",
            "description": "Source to sink steps in order, for readers and fixing agents.",
            "items": {
              "type": "object",
              "required": [
                "location",
                "note"
              ],
              "properties": {
                "location": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "attempt"
            ],
            "properties": {
              "state": {
                "enum": [
                  "draft",
                  "final"
                ]
              },
              "attempt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
