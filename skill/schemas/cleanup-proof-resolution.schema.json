{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cleanup-proof-resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token",
    "actor",
    "evidence",
    "processes_stopped"
  ],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "processes_stopped": {
      "const": true
    }
  }
}
