{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "readiness",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "object",
      "required": [
        "model",
        "storage",
        "source",
        "validation",
        "cleanup"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "enum": [
              "passed",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "state",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "source_ref",
    "checks"
  ]
}
