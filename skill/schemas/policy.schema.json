{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMGS committed policy",
  "description": "Required fields never default. Explicit null persona/budget retain legacy unselected/unbounded behavior. The CLI additionally rejects duplicate intent id/scope pairs, duplicate suppression fingerprints, unknown intent IDs and control characters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "persona",
    "budget",
    "severity_threshold",
    "excluded_paths",
    "accepted_intent",
    "suppressions",
    "gate_tests"
  ],
  "properties": {
    "schema": {
      "const": "omgs-policy/1"
    },
    "mode": {
      "enum": [
        "gate",
        "advisory"
      ]
    },
    "persona": {
      "enum": [
        null,
        "builder",
        "inheritor",
        "team"
      ]
    },
    "budget": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "severity_threshold": {
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "excluded_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
      }
    },
    "accepted_intent": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "answer",
          "scope",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Shipped intent library ID."
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "anyOf": [
              {
                "const": "repo"
              },
              {
                "type": "string",
                "pattern": "^(?!/)(?!.*[\\\\:])(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
              }
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "reason",
          "expires_unix"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^omgs-[0-9a-f]{16}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expires_unix": {
            "type": "integer",
            "minimum": 0,
            "description": "Required UTC Unix seconds through year 9999, at most 365 days after the commit that last changed policy. Inactive at or after this instant. The CLI enforces the commit-relative bound.",
            "maximum": 253402300799
          }
        }
      }
    },
    "gate_tests": {
      "type": "array",
      "description": "Owner-reviewed security tests authorized by committed base policy. Duplicate ids or test paths are refused.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "test",
          "command",
          "expect_marker",
          "severity",
          "timeout_ms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "test": {
            "type": "string",
            "minLength": 1,
            "description": "Safe repository-relative committed regular test path, named by command."
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "expect_marker": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,128}$",
            "description": "Same contract as prove --expect-marker; reserved markers are refused."
          },
          "severity": {
            "enum": [
              "informational",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^omgs-[0-9a-f]{16}$"
          }
        }
      }
    }
  }
}
