{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cleanup-resource",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "checkout",
        "evidence",
        "scratch",
        "process",
        "tunnel",
        "remote_job"
      ]
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "kind",
    "location",
    "owner",
    "locator"
  ]
}
