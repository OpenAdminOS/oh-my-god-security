{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained attempt event",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "id",
        "role",
        "identity",
        "context",
        "inputs",
        "outputs",
        "isolation"
      ],
      "properties": {
        "event": {
          "const": "start"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "host",
            "hunter",
            "verifier",
            "evaluator",
            "guard"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "isolation": {
          "enum": [
            "procedural",
            "host_enforced"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "id",
        "actor",
        "reason"
      ],
      "properties": {
        "event": {
          "const": "complete"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "id",
        "actor",
        "kind",
        "reason",
        "artifacts",
        "disposition"
      ],
      "properties": {
        "event": {
          "const": "stop"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "provider",
            "policy"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disposition": {
          "enum": [
            "quarantined",
            "discarded",
            "pending_review"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "id",
        "actor",
        "authority",
        "reason",
        "replacement"
      ],
      "properties": {
        "event": {
          "const": "resolve"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "enum": [
            "host",
            "user"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "replacement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "id",
        "turn",
        "actor",
        "reason"
      ],
      "properties": {
        "event": {
          "const": "dispatch"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "turn": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
