{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMGS coverage ledger",
  "type": "object",
  "required": ["units"],
  "properties": {
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "surface", "attack_classes", "status"],
        "properties": {
          "id": { "type": "string" },
          "surface": { "type": "string" },
          "attack_classes": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["planned", "candidate", "covered", "deferred", "blocked", "out_of_scope"] },
          "evidence": {
            "type": "array",
            "items": { "type": "string" },
            "description": "What shows the unit was examined: finding fingerprints, candidate files, or repo paths."
          },
          "note": { "type": "string", "description": "Why the unit was deferred, blocked, or put out of scope." }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "covered" } } },
            "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
          },
          {
            "if": { "properties": { "status": { "enum": ["deferred", "blocked", "out_of_scope"] } } },
            "then": { "required": ["note"], "properties": { "note": { "minLength": 1 } } }
          }
        ]
      }
    }
  }
}
