{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMGS findings",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fingerprint", "title", "verdict", "proof_tier", "attack_class", "entry_point", "sink", "boundary", "location", "hunted_by", "verified_by"],
        "properties": {
          "fingerprint": { "type": "string", "pattern": "^omgs-[0-9a-f]{16}$" },
          "title": { "type": "string" },
          "verdict": { "enum": ["confirmed", "needs_validation", "rejected"] },
          "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
          "proof_tier": { "enum": ["traced", "test_proven", "sandbox_exploited"] },
          "attack_class": { "type": "string" },
          "entry_point": { "type": "string" },
          "sink": { "type": "string" },
          "boundary": { "type": "string" },
          "location": {
            "type": "object",
            "required": ["path"],
            "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } }
          },
          "locations": {
            "type": "array",
            "description": "Further locations of the same root cause, so one copied defect stays one record.",
            "items": {
              "type": "object",
              "required": ["path"],
              "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } }
            }
          },
          "evidence": { "type": "string" },
          "fix_brief": { "type": "string" },
          "intent_question": { "type": "string" },
          "intent_id": { "type": "string", "description": "Intent library question this record asks (omgs intent list)." },
          "family": { "type": "string" },
          "prerequisites": { "type": "string" },
          "hunted_by": { "type": "string", "minLength": 1, "description": "Hunter whose candidate produced this record." },
          "verified_by": { "type": "string", "minLength": 1, "description": "Independent verifier who decided this record. Must differ from hunted_by." },
          "candidates": {
            "type": "array",
            "uniqueItems": true,
            "description": "Fingerprints of further candidates merged into this record; its own fingerprint is implicit.",
            "items": { "type": "string", "pattern": "^omgs-[0-9a-f]{16}$" }
          }
        }
      }
    }
  }
}
